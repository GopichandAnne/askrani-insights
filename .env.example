# ─────────────────────────────────────────────────────────────────────────────
# local-intel environment
# Copy to .env.local and fill in. Never commit real keys.
# Adapters/features light up automatically when their keys are present; absent
# keys leave that provider disabled (see src/lib/providers/registry.ts).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by ingestion/extraction workers. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI extraction (required for the intelligence layer) -------------------
# Primary multimodal model (guide keeps this behind an abstraction; see
# src/lib/extraction/llm.ts). Claude is the default.
ANTHROPIC_API_KEY=
# Optional secondary provider behind the same abstraction (guide 3.1).
OPENAI_API_KEY=

# --- Google (optional — enables Places discovery, Reviews, Photos) ---------
# When set, the Google adapter activates. When empty, discovery falls back to
# website + OpenStreetMap/Nominatim (guide 3.1).
GOOGLE_MAPS_API_KEY=
# Google Business Profile authorized connector (owner-authorized data).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Social collection (optional — activates social adapters) --------------
# Apify managed Actors for public IG/FB/TikTok posts (guide 3.2).
APIFY_TOKEN=
# Bright Data enterprise fallback / datasets (guide 3.3).
BRIGHTDATA_API_TOKEN=
# Yelp Fusion — business reviews/ratings (official API). Get a key at
# https://www.yelp.com/developers (free tier, rate-limited).
YELP_API_KEY=

# --- Meta authorized connector (DEFERRED for this build) -------------------
# Intentionally not wired: Meta app review is a separate workstream. The
# schema and connector shape exist; leave blank. (User decision.)
META_APP_ID=
META_APP_SECRET=

# --- App config ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowlist of hosts the crawler may fetch beyond target
# businesses (empty = crawl only businesses added to a workspace).
CRAWL_EXTRA_ALLOWED_HOSTS=

# Shared secret the background collection worker uses to call /api/worker/tick.
# Any random string; the worker (npm run worker) and the route must match.
WORKER_SECRET=
