# ─────────────────────────────────────────────────────────────────────────────
# local-intel environment
# Copy to .env.local and fill in. Never commit real keys.
# Adapters/features light up automatically when their keys are present; absent
# keys leave that provider disabled (see src/lib/providers/registry.ts).
# ─────────────────────────────────────────────────────────────────────────────

# --- Supabase (required) ---------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by ingestion/extraction workers. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI extraction (required for the intelligence layer) -------------------
# Primary multimodal model (guide keeps this behind an abstraction; see
# src/lib/extraction/llm.ts). Claude is the default.
ANTHROPIC_API_KEY=
# Optional secondary provider behind the same abstraction (guide 3.1).
OPENAI_API_KEY=

# --- Google (optional — enables Places discovery, Reviews, Photos) ---------
# When set, the Google adapter activates. When empty, discovery falls back to
# website + OpenStreetMap/Nominatim (guide 3.1).
GOOGLE_MAPS_API_KEY=
# Google Business Profile authorized connector (owner-authorized data).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Social collection (optional — activates social adapters) --------------
# Apify managed Actors for public IG/FB/TikTok posts (guide 3.2).
APIFY_TOKEN=
# Bright Data enterprise fallback / datasets (guide 3.3).
BRIGHTDATA_API_TOKEN=
# Yelp Fusion — business reviews/ratings (official API). Get a key at
# https://www.yelp.com/developers (free tier, rate-limited).
YELP_API_KEY=
# YouTube Data API v3 — channel videos/descriptions (official, free quota).
YOUTUBE_API_KEY=

# --- Apify platform Actors (optional; social/delivery collection) ----------
# Scraping these platforms is against their ToS — activate at your discretion
# (see docs). Actor ids are overridable; delivery requires an explicit Actor id.
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_FACEBOOK_ACTOR=apify~facebook-posts-scraper
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_DOORDASH_ACTOR=
APIFY_UBEREATS_ACTOR=

# --- Meta authorized connector (DEFERRED for this build) -------------------
# Intentionally not wired: Meta app review is a separate workstream. The
# schema and connector shape exist; leave blank. (User decision.)
META_APP_ID=
META_APP_SECRET=

# --- App config ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated allowlist of hosts the crawler may fetch beyond target
# businesses (empty = crawl only businesses added to a workspace).
CRAWL_EXTRA_ALLOWED_HOSTS=

# Shared secret the background collection worker uses to call /api/worker/tick.
# Any random string; the worker (npm run worker) and the route must match.
WORKER_SECRET=
# Comma-separated emails granted the platform Super Admin console (/admin).
SUPERADMIN_EMAILS=
# Vercel Cron secret (production worker). Vercel sends it as
# `Authorization: Bearer $CRON_SECRET` to /api/worker/tick. Set in Vercel env.
CRON_SECRET=

# --- Report delivery (weekly/daily digest + on-demand) ---------------------
# EMAIL (Resend). When set, the digest cron and on-demand send email the report
# (branded HTML + the full PDF attached). Unset = graceful no-op (report still
# lives in-app / downloads as PDF).
RESEND_API_KEY=
# From address for the digest email (verified sender/domain in Resend).
DIGEST_FROM="Ask Rani Insights <insights@askrani.ai>"

# WHATSAPP (Meta WhatsApp Business Cloud API). When TOKEN + PHONE_ID are set, the
# report is delivered to the owner's saved number as a PDF document. A business-
# initiated push needs a PRE-APPROVED template (default name "market_report"):
#   HEADER: Document · BODY: "Hi {{1}}, your latest market report is ready — {{2}}"
# Unset = graceful no-op.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=market_report
WHATSAPP_LANG=en_US
# Optional Graph API version override (default v21.0).
WHATSAPP_API_VERSION=
# INBOUND WhatsApp Q&A (the two-way assistant). Point the WhatsApp app's webhook
# at /api/whatsapp/webhook. WHATSAPP_VERIFY_TOKEN is any random string you also
# enter in Meta's webhook setup; WHATSAPP_APP_SECRET (the Meta app secret) verifies
# payload signatures. Owners message the number and get answers grounded strictly
# in their collected data.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# The dialable business number owners message to chat (display + wa.me link),
# e.g. +15125550142. WHATSAPP_PHONE_ID is Meta's internal id, not this.
WHATSAPP_BUSINESS_NUMBER=

# --- Rani operations slice (the "one data umbrella": inside + outside) ----------
# The advisor also grounds in the business's OWN Rani store data (best-sellers,
# promos, loyalty reach, promote-and-earn advocates) — aggregates only, no raw PII.
# Two ways to feed it: Rani pushes a slice onto workspace.goals.raniOps (works with
# no config), OR set a governed read-only endpoint Insights pulls:
RANI_OPS_URL=
RANI_OPS_SECRET=
